#!/usr/bin/env bash
# Usage: .github/scripts/b2-retry <b2 CLI> <arguments...>
#
# Runs a b2 command, and runs it again when it fails, six tries over about
# 15 minutes. B2 answers "503 too_busy" now and then, to a large file's
# parts most of all, and the CLI's own retries last about a minute.
#
# A refusal that another try cannot change (a 4xx other than 408 or 429: a
# bad key, a missing bucket) fails at once. Any other failure is tried
# again: a 5xx, a timeout, a dropped connection, or an error the CLI prints
# without a status code.
#
# B2_RETRY_WAITS overrides the seconds between tries ("30 60 120 240 480").
set -uo pipefail

read -ra waits <<< "${B2_RETRY_WAITS:-30 60 120 240 480}"
err=$(mktemp)
trap 'rm -f "$err"' EXIT

try=1
for wait in "${waits[@]}" last; do
  "$@" 2> "$err"
  rc=$?
  [ "$rc" -ne 0 ] || exit 0
  cat "$err" >&2
  if grep -qE '\b4[0-9]{2}\b' "$err" && ! grep -qE '\b(408|429|5[0-9]{2})\b' "$err"; then
    echo "b2-retry: B2 refused the request; not trying again" >&2
    exit "$rc"
  fi
  if [ "$wait" = last ]; then
    echo "b2-retry: failed $try times; giving up" >&2
    exit "$rc"
  fi
  echo "b2-retry: try $try failed; trying again in $wait s" >&2
  sleep "$wait"
  try=$((try + 1))
done
