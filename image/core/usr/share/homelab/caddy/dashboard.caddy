# The dashboard and its API, as a snippet: the domain's site (written by the
# daemon from the host settings) imports it at the dashboard's name.
#
# The API goes to the daemon's web socket, where every request but signing in
# needs the dashboard's session. In a route, so the stack refusal runs first:
# a stack never reaches the dashboard, whose API approves grants.
(homelab_dashboard) {
	route {
		@stack remote_ip 10.99.0.0/16
		respond @stack "The dashboard is not reachable from a stack." 403

		handle /api/* {
			reverse_proxy unix//run/homelab-daemon/web.sock {
				flush_interval -1
			}
		}
		handle /_app/immutable/* {
			root * /usr/share/homelab/dashboard
			header Cache-Control "public, max-age=31536000, immutable"
			file_server {
				precompressed br gzip
			}
		}
		handle {
			root * /usr/share/homelab/dashboard
			try_files {path} /index.html
			file_server {
				precompressed br gzip
			}
		}
	}
}

# On every address over plain HTTP. Before the host has a domain this serves
# the dashboard; once it has one, the daemon's redirect.caddy sends the
# browser to the HTTPS name instead.
:80 {
	import /var/lib/homelab/caddy/http/*.caddy
	import homelab_dashboard
}
