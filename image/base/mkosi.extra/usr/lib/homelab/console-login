#!/bin/sh
# agetty for the console: the screen and keyboard (kmsconvt@ and its
# fallback getty@) and the serial port (serial-getty@). It logs root in
# without asking, on the installer stick and on an installed host alike:
# whoever sits at the keyboard or the serial port can boot anything or take
# the disk anyway, so a login there protects nothing. Root has no password
# (mkosi.finalize.chroot), so this is the only way in at the console, and
# SSH stays key-only.
exec /usr/bin/agetty --autologin root "$@"
