enable systemd-networkd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable sshd.service
enable homelab-ssh-hostkey.service
enable nix-daemon.socket
enable systemd-sysext.service
enable homelab-core-update.service
enable systemd-confext.service
enable homelab-boot-check.service
enable homelab-extension-units.service
enable systemd-repart.service
# kmscon on tty1; getty@ is its fallback (OnFailure=).
enable kmsconvt@.service
# A login on the first serial port; no getty starts by itself
# (systemd.getty_auto=0).
enable serial-getty@.service ttyS0
