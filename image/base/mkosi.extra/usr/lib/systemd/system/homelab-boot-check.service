[Unit]
Description=Check this image version is healthy
Requires=boot-complete.target
Before=boot-complete.target
After=sshd.service systemd-networkd.service local-fs.target homelab-extension-units.service
# No FailureAction=reboot: the check restarts the host itself, and only
# while the boot loader counts this version's tries (usr/lib/homelab/boot-check).
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/homelab/boot-check
TimeoutStartSec=10min
[Install]
RequiredBy=boot-complete.target
WantedBy=multi-user.target
